# Text-DIRE Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key (for GPT models)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (for Claude models)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Optional: HuggingFace token (for gated models)
# HF_TOKEN=hf_your-token-here

# Website scoring provider:
# demo = local placeholder scorer for UI testing, no GPU needed
# modal = real Text-DIRE scoring through a deployed Modal GPU function
TEXTDIRE_PROVIDER=demo

# Optional Modal lookup settings for TEXTDIRE_PROVIDER=modal
TEXTDIRE_MODAL_APP=text-dire
TEXTDIRE_MODAL_FUNCTION=compute_dire_scores_batch
